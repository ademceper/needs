{
  "name": "keycloak",
  "version": "0.0.1",
  "description": "Keycloakify theme",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "keycloakify start-keycloak --keycloak-version 26",
    "build": "tsc && vite build",
    "build-keycloak-theme": "pnpm build && keycloakify build",
    "storybook": "storybook dev -p 6006",
    "lint": "biome lint",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@keycloakify/keycloak-account-ui": "^260502.0.2",
    "@keycloakify/keycloak-ui-shared": "^260502.0.0",
    "@pangea/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "i18next": "^25.7.3",
    "i18next-fetch-backend": "^6.0.0",
    "keycloakify": "^11.15.0",
    "lodash-es": "^4.17.22",
    "oidc-spa": "^10.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.70.0",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@keycloak/keycloak-admin-client": "^26.6.1",
    "@pangea/ts-cfg": "workspace:*",
    "@storybook/react": "^8.1.10",
    "@storybook/react-vite": "^8.1.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "postcss": "^8.4.47",
    "storybook": "^8.1.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}